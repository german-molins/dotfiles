{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "defaultMode": "auto",
  "permissions": {
    "allow": [
      "mcp__plugin_context-mode_context-mode__ctx_search",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git commit *)",
      "Bash(git add *)",
      "Bash(jj status*)",
      "Bash(jj log*)",
      "Bash(jj diff*)",
      "Bash(jj show*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(mise help*)",
      "Bash(mise run *)",
      "Bash(mise use*)",
      "Bash(mise ls*)",
      "Bash(mise tasks*)",
      "Bash(cargo help*)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(cargo check*)",
      "Bash(cargo install*)",
      "Bash(cargo uninstall*)",
      "Bash(cargo search*)",
      "Bash(bd prime*)",
      "Bash(bd status*)",
      "Bash(bd ready*)",
      "Bash(bd show*)",
      "Bash(bd search*)",
      "Bash(bd list*)",
      "Bash(bd update*)",
      "Bash(bd comment*)",
      "Bash(bd note*)",
      "Bash(bd dep*)",
      "Bash(bd blocked*)",
      "Bash(bd epic*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh release delete*)",
      "Bash(gh workflow disable*)",
      "Bash(gh secret *)",
      "Bash(gh auth logout*)",
      "Bash(sudo *)",
      "Bash(chmod -R 777*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.*.env)",
      "Read(~/.ssh/**)"
    ]
  },
  "model": "claude-opus-5-5",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/german-molins/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/plugins/cache/caveman/caveman/*/hooks/caveman-statusline.sh"
  },
  "enabledPlugins": {
    "beads@beads-marketplace": true,
    "caveman@caveman": false,
    "context-mode@context-mode": true,
    "context7@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "nono@nolabs-ai": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "editorMode": "vim"
}
