#!/usr/bin/env python3
#MISE description="List running processes of mise tools on an older version than their current one"
#USAGE flag "--json" help="Print the processes as JSON"
"""List processes still running a mise tool version that is no longer current.

A process is stale when its executable, or the script it runs, lives in an
install dir of a tool whose active version for the process's cwd is another
one. Processes whose ancestor is stale are left out: they restart with it.
"""

from __future__ import annotations

import json
import os
import platform
import re
import subprocess
import sys
from dataclasses import asdict, dataclass
from functools import cache
from pathlib import Path

INSTALL = re.compile(r"(?P<root>.*/mise/installs/(?P<tool>[^/]+)/(?P<version>[^/]+))(/|$)")


@dataclass
class Proc:
    """A running process."""

    pid: int
    ppid: int
    exe: str
    argv: list[str]


@dataclass
class Stale:
    """A stale process, with its pane and agent when Herdr manages it."""

    pid: int
    tool: str
    running: str
    current: str
    cmdline: str
    cwd: str
    pane: str | None
    agent: str | None
    agent_status: str | None


def run(*cmd: str) -> str:
    """Return a command's stdout, or an empty string when it fails.

    :param cmd: The command and its arguments.
    :return: The command's stdout.
    """
    try:
        return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return ""


def processes() -> dict[int, Proc]:
    """Collect every process of the current user.

    :return: The processes by pid.
    """
    procs: dict[int, Proc] = {}
    if platform.system() == "Linux":
        for d in Path("/proc").iterdir():
            if not d.name.isdigit():
                continue
            try:
                exe = os.readlink(d / "exe").removesuffix(" (deleted)")
                argv = (d / "cmdline").read_bytes().decode(errors="replace").split("\0")[:-1]
                ppid = int((d / "stat").read_text().rsplit(")", 1)[1].split()[1])
            except OSError:
                continue
            procs[int(d.name)] = Proc(int(d.name), ppid, exe, argv)
        return procs
    exes = {}
    for line in run("ps", "-x", "-o", "pid=,comm=").splitlines():
        pid, _, comm = line.strip().partition(" ")
        exes[int(pid)] = comm.strip()
    for line in run("ps", "-x", "-o", "pid=,ppid=,args=").splitlines():
        pid, ppid, *args = line.split(None, 2)
        procs[int(pid)] = Proc(int(pid), int(ppid), exes.get(int(pid), ""), args[0].split() if args else [])
    return procs


def cwd_of(pid: int) -> str:
    """Return a process's working directory, or $HOME when it can't be read.

    :param pid: The process id.
    :return: The working directory.
    """
    if platform.system() == "Linux":
        try:
            return os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            return str(Path.home())
    out = run("lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn")
    return next((line[1:] for line in out.splitlines() if line.startswith("n")), str(Path.home()))


@cache
def active(cwd: str) -> dict[str, tuple[str, str]]:
    """Map each tool's install dir parent to its active install path and version.

    :param cwd: The directory whose mise environment to resolve.
    :return: Active install root and version, keyed by ``installs/<tool>`` dir.
    """
    out = run("mise", "-C", cwd if Path(cwd).is_dir() else str(Path.home()), "ls", "--current", "--json")
    current: dict[str, tuple[str, str]] = {}
    for versions in json.loads(out or "{}").values():
        for v in versions:
            if v.get("active") and v.get("install_path"):
                path = v["install_path"].rstrip("/")
                current[str(Path(path).parent)] = (path, v["version"])
    return current


def install_of(proc: Proc) -> re.Match[str] | None:
    """Find the mise install a process runs from: its executable or script.

    :param proc: The process.
    :return: The install match, preferring a script under a tool other than its
        interpreter (e.g. an npm tool run by node).
    """
    matches = [m for p in [proc.exe, *proc.argv[1:2]] if (m := INSTALL.match(p))]
    return matches[-1] if matches else None


def herdr_panes() -> tuple[dict[int, str], dict[str, tuple[str, str]]]:
    """Map Herdr pane shells to panes, and panes to their agent and status.

    :return: Pane id by shell pid, and (agent, status) by pane id.
    """
    if os.environ.get("HERDR_ENV") != "1":
        return {}, {}
    shells: dict[int, str] = {}
    panes = json.loads(run("herdr", "pane", "list") or "{}").get("result", {}).get("panes", [])
    for pane in panes:
        info = json.loads(run("herdr", "pane", "process-info", "--pane", pane["pane_id"]) or "{}")
        if pid := info.get("result", {}).get("process_info", {}).get("shell_pid"):
            shells[pid] = pane["pane_id"]
    agents = json.loads(run("herdr", "agent", "list") or "{}").get("result", {}).get("agents", [])
    return shells, {a["pane_id"]: (a["agent"], a["agent_status"]) for a in agents}


def ancestors(pid: int, procs: dict[int, Proc]) -> list[int]:
    """List a process's ancestors, nearest first.

    :param pid: The process id.
    :param procs: All processes.
    :return: The ancestor pids.
    """
    chain = []
    while (p := procs.get(pid)) and p.ppid not in chain and p.ppid > 1:
        chain.append(p.ppid)
        pid = p.ppid
    return chain


def stale() -> list[Stale]:
    """Find the stale processes.

    :return: The stale processes, outermost only.
    """
    procs = processes()
    found: dict[int, tuple[re.Match[str], str, str]] = {}
    for proc in procs.values():
        if not (m := install_of(proc)):
            continue
        cwd = cwd_of(proc.pid)
        current = active(cwd).get(str(Path(m["root"]).parent))
        if current and current[0] != m["root"]:
            found[proc.pid] = (m, current[1], cwd)
    shells, agents = herdr_panes()
    result = []
    for pid, (m, current, cwd) in found.items():
        chain = ancestors(pid, procs)
        if any(a in found for a in chain):
            continue
        pane = next((shells[a] for a in chain if a in shells), None)
        agent, status = agents.get(pane, (None, None)) if pane else (None, None)
        result.append(
            Stale(pid, m["tool"], m["version"], current, " ".join(procs[pid].argv), cwd, pane, agent, status)
        )
    return sorted(result, key=lambda s: (s.tool, s.pane or "", s.pid))


def main() -> None:
    """Print the stale processes as a table, or as JSON with ``--json``."""
    rows = stale()
    if "--json" in sys.argv[1:] or os.environ.get("usage_json") == "true":
        print(json.dumps([asdict(r) for r in rows], indent=2))
        return
    if not rows:
        print("no stale processes")
        return
    header = ("PID", "TOOL", "RUNNING", "CURRENT", "PANE", "AGENT", "COMMAND")
    table = [
        (str(r.pid), r.tool, r.running, r.current, r.pane or "-",
         f"{r.agent} ({r.agent_status})" if r.agent else "-", r.cmdline[:60])
        for r in rows
    ]
    widths = [max(len(row[i]) for row in [header, *table]) for i in range(len(header) - 1)]
    for row in [header, *table]:
        print("  ".join(c.ljust(w) for c, w in zip(row, widths)) + "  " + row[-1])


if __name__ == "__main__":
    main()
